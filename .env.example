# Copy this file to .env and adjust values. All settings are optional.

# Path to the SQLite database file (relative paths resolve from the project root)
SMARTSTOCK_DB_PATH=data/smartstock.db

# Forecast horizon in days
SMARTSTOCK_FORECAST_HORIZON=30

# Target cycle service level used for safety stock (0.50 - 0.999)
SMARTSTOCK_SERVICE_LEVEL=0.95

# Default supplier lead time in days when an item has none
SMARTSTOCK_DEFAULT_LEAD_TIME=7

# Default purchasing budget used by the budget optimizer
SMARTSTOCK_DEFAULT_BUDGET=50000

# Random seed for reproducible sample data and models
SMARTSTOCK_RANDOM_SEED=42
